    {
      "name": "AUTENTICACIÓN",
      "item": [
        {
          "name": "LOGIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const cuerpoRespuesta = pm.response.json();",
                  "    const accessToken  = cuerpoRespuesta.data.accessToken;",
                  "    const refreshToken = cuerpoRespuesta.data.refreshToken;",
                  "    pm.environment.set('ACCESS_TOKEN',  accessToken);",
                  "    pm.environment.set('REFRESH_TOKEN', refreshToken);",
                  "    console.log('Access y Refresh token guardados automáticamente');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sebastian@sena.edu.co\",\n  \"password\": \"sebas123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{URL_API}}/auth/login",
              "host": [
                "{{URL_API}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión y guarda automáticamente ACCESS_TOKEN y REFRESH_TOKEN en las variables de entorno.\n\nLa respuesta ahora incluye el campo `roles` con los permisos RBAC del usuario."
          },
          "response": []
        },
