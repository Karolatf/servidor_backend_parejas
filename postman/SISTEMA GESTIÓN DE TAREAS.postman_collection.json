  "item": [
    {
      "name": "AUTENTICACIÓN",
      "item": [
        {
          "name": "LOGIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {\r",
                  "    const cuerpoRespuesta = pm.response.json();\r",
                  "    \r",
                  "    const accessToken  = cuerpoRespuesta.data.accessToken;\r",
                  "    const refreshToken = cuerpoRespuesta.data.refreshToken;\r",
                  "    \r",
                  "    pm.environment.set('ACCESS_TOKEN',  accessToken);\r",
                  "    pm.environment.set('REFRESH_TOKEN', refreshToken);\r",
                  "    \r",
                  "    console.log('Access y Refresh token guardados automáticamente');\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCES_TOKEN}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"sebastian@sena.edu.co\",\r\n  \"password\": \"SEBAS2003\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{URL_API}}/auth/login",
              "host": [
                "{{URL_API}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
