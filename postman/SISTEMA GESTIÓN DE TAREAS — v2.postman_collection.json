          },
          "response": []
        }
      ]
    },
    {
      "name": "RECUPERACIÓN DE CONTRASEÑA",
      "item": [
        {
          "name": "PASO 1 — SOLICITAR CÓDIGO",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sebastian@sena.edu.co\"\n}",
              "options": {
                "raw": {
                  "language": "json"
