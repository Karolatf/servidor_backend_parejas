            },
            "url": {
              "raw": "{{URL_API}}/auth/forgot-password",
              "host": [
                "{{URL_API}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Paso 1 del flujo de recuperación.\n\nEnvía un código de 6 dígitos al correo del usuario vía Mailtrap.\nEl código expira en 15 minutos.\n\nRespuesta 200 tanto si el email existe como si no (seguridad: no filtra emails registrados)."
          },
          "response": []
        },
        {
          "name": "PASO 2 — VERIFICAR CÓDIGO",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sebastian@sena.edu.co\",\n  \"code\": \"560095\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{URL_API}}/auth/verify-reset-code",
              "host": [
                "{{URL_API}}"
              ],
              "path": [
                "auth",
                "verify-reset-code"
              ]
            },
            "description": "Paso 2 del flujo de recuperación.\n\nVerifica el código de 6 dígitos recibido en Mailtrap.\nReemplaza el valor de `code` con el código real que llegó al sandbox.\n\nRespuesta 400 si el código es incorrecto o ha expirado."
          },
          "response": []
        },
        {
          "name": "PASO 3 — RESTABLECER CONTRASEÑA",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sebastian@sena.edu.co\",\n  \"newPassword\": \"sebas1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{URL_API}}/auth/reset-password",
              "host": [
                "{{URL_API}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Paso 3 del flujo de recuperación.\n\nCambia la contraseña del usuario. Solo funciona si el código fue verificado previamente en el Paso 2.\n\nRespuesta 400 si se intenta sin haber pasado por el Paso 2 primero."
          },
          "response": []
        }
      ]
